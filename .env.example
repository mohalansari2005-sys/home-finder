# server + worker
DATABASE_URL=postgresql+psycopg://hf:CHANGE_ME@db:5432/homefinder
POSTGRES_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_64_RANDOM_CHARS  # openssl rand -hex 32 (the api refuses to start in production with a placeholder)
FAMILY_PASSWORD_HASH=  # python -m homefinder.cli hash-password
COOKIE_SECURE=true
WORKER_TOKEN=CHANGE_ME_RANDOM  # openssl rand -hex 24 (>= 32 chars)
DOMAIN=example.com
TAILSCALE_IP=100.x.y.z
PHOTOS_DIR=/data/photos
OPENAI_API_KEY=
OPENAI_MODEL_SMALL=gpt-5-mini
OPENAI_MODEL_LARGE=gpt-5
OPENAI_MONTHLY_CAP_USD=20
TOMTOM_API_KEY=  # server + worker only; the browser map (OpenFreeMap) needs no key
TOMTOM_DAILY_REQUEST_CAP=2300  # requests over a cap are skipped, never sent
TOMTOM_MONTHLY_REQUEST_CAP=18000
# worker only (Mac): point at the server over Tailscale
SERVER_URL=http://100.x.y.z
